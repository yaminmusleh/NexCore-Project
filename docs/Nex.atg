COMPILER Nex

CHARACTERS

    letter = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz".
    digit  = "0123456789".

    stringChar =
    ANY - '"' - '\r' - '\n'.


TOKENS

    assign        = "=".
    condition_eq  = "==".
    bang_equal    = "!=".
    less          = "<".
    less_equal    = "<=".
    greater       = ">".
    greater_equal = ">=".

    semi          = ";".
    open_paren    = "(".
    close_paren   = ")".
    open_scope    = "{".
    close_scope   = "}".

    plus          = "+".
    minus         = "-".
    star          = "*".
    slash         = "/".
    percent       = "%".

    logical_and   = "&&".
    logical_or    = "||".
    logical_not   = "!".

    identifier    = letter { letter | digit }.
    int_lit       = digit { digit }.
    float_lit     = digit { digit } "." digit { digit } "f".
    double_lit    = digit { digit } "." digit { digit } "d".
    string_lit    = '"' { stringChar } '"'.
    


COMMENTS FROM "//" TO "\n"
COMMENTS FROM "/*" TO "*/" NESTED

IGNORE '\r' + '\n' + '\t' + ' '


PRODUCTIONS


Nex
(.
    NodeStmnt *statement = nullptr;
.)
=
{
    Statement<statement>
    (.
        if (statement != nullptr)
            program.statements.push_back(statement);
    .)
}
.


Statement<NodeStmnt *&statement>
(.
    statement = nullptr;
.)
=
     
      SetStmt<statement>
    | ExitStmt<statement>
    | IfStmt<statement>
    | ForStmt<statement>
    | WhileStmt<statement>
    | BlockStmt<statement>
    | PrintStmnt<statement>
    | AssignStmt<statement>
    
.


SetStmt<NodeStmnt *&statement>
(.
    std::string name;
    NodeExpr *expr = nullptr;
.)
=
    "set"
    identifier
    (.
        name = token_string(t);
    .)
    assign
    Expression<expr>
    semi
    (.
        statement = make_let(name, expr);
    .)
.


AssignStmt<NodeStmnt *&statement>
(.
    std::string name;
    NodeExpr *expr = nullptr;
.)
=
    identifier
    (.
        name = token_string(t);
    .)
    assign
    Expression<expr>
    semi
    (.
        statement = make_assign(name, expr);
    .)
.


ExitStmt<NodeStmnt *&statement>
(.
    NodeExpr *expr = nullptr;
.)
=
    "exit"
    open_paren
    Expression<expr>
    close_paren
    semi
    (.
        statement = make_exit(expr);
    .)
.

PrintStmnt<NodeStmnt *&statement>
(.
    NodeExpr *expr = nullptr;
.)
=
    "print"
    open_paren
    Expression<expr>
    close_paren
    semi
    (.
       statement = make_print_statement(expr);
    .)
.

IfStmt<NodeStmnt *&statement>
(.
    NodeExpr *condition = nullptr;
    NodeScope *scope = nullptr;
    NodeScope *else_scope = nullptr;
    NodeStmntIf *else_if = nullptr;
    NodeStmnt *else_statement = nullptr;
.)
=
    "iff"
    open_paren
    Expression<condition>
    close_paren

    BlockStmt<statement>

    (.
        scope =
            std::get<NodeScope *>(statement->stmnt);
    .)

    [
        "otherwise"

        (
            IfStmt<else_statement>
            (.
                else_if =
                    get_if_statement(else_statement);
            .)

          |

            BlockStmt<else_statement>
            (.
                else_scope =
                    std::get<NodeScope *>(
                        else_statement->stmnt
                    );
            .)
        )
    ]

    (.
        statement =
            make_if(
                condition,
                scope,
                else_scope,
                else_if
            );
    .)
.

ForStmt<NodeStmnt *&statement>
(.
    NodeStmnt *initialisation = nullptr;
    NodeExpr *condition = nullptr;
    NodeStmnt *increment = nullptr;

    NodeStmnt *body_statement = nullptr;
    NodeScope *scope = nullptr;
.)
=
    "for"
    open_paren
    ForInit<initialisation>
    semi

    Expression<condition>
    semi

    ForIncrement<increment>
    close_paren

    BlockStmt<body_statement>
    (.
       scope =
         std::get<NodeScope *>(
            body_statement->stmnt
         );
       statement =
          make_for(
            initialisation,
            condition,
            increment,
            scope
          );
    .)
.

ForInit<NodeStmnt *&statement>
(.
      std::string name;
      NodeExpr *expr = nullptr;
.)
=
       "set"
      identifier
      (.
          name = token_string(t);
      .)
      assign
      Expression<expr>
      (.
          statement = make_let(name, expr);
      .)
      
    |
       identifier
      (.
          name = token_string(t);
      .)
      assign
      Expression<expr>
      (.
          statement = make_assign(name, expr);
      .)

.

ForIncrement<NodeStmnt *&statement>
(.
    std::string name;
    NodeExpr *expr = nullptr;
.)
=
    identifier
    (.
        name = token_string(t);
    .)
    assign
    Expression<expr>
    (.
        statement = make_assign(name, expr);
    .)
.


WhileStmt<NodeStmnt *&statement>
(.
    NodeExpr *condition = nullptr;
    NodeStmnt *body_statement = nullptr;
    NodeScope *scope = nullptr;
.)
=
    "whilst"
    open_paren
    Expression<condition>
    close_paren

    BlockStmt<body_statement>

    (.
        scope =
            std::get<NodeScope *>(
                body_statement->stmnt
            );

        statement =
            make_while(
                condition,
                scope
            );
    .)
.


BlockStmt<NodeStmnt *&statement>
(.
    NodeScope *scope = nullptr;
    NodeStmnt *child = nullptr;
.)
=
    open_scope

    (.
        scope = make_scope();
    .)

    {
        Statement<child>
        (.
            if (child != nullptr)
                scope->statements.push_back(child);
        .)
    }

    close_scope

    (.
        statement =
            make_scope_statement(scope);
    .)
.


Expression<NodeExpr *&expr>
=
    OrExpr<expr>
.


OrExpr<NodeExpr *&left>
(.
    NodeExpr *right = nullptr;
    std::string op;
.)
=
    AndExpr<left>

    {
        logical_or

        (.
            op = token_string(t);
        .)

        AndExpr<right>

        (.
            left =
                make_binary_expr(
                    left,
                    op,
                    right
                );
        .)
    }
.


AndExpr<NodeExpr *&left>
(.
    NodeExpr *right = nullptr;
    std::string op;
.)
=
    EqualityExpr<left>

    {
        logical_and

        (.
            op = token_string(t);
        .)

        EqualityExpr<right>

        (.
            left =
                make_binary_expr(
                    left,
                    op,
                    right
                );
        .)
    }
.


EqualityExpr<NodeExpr *&left>
(.
    NodeExpr *right = nullptr;
    std::string op;
.)
=
    RelationalExpr<left>

    {
        (
            condition_eq
          | bang_equal
        )

        (.
            op = token_string(t);
        .)

        RelationalExpr<right>

        (.
            left =
                make_binary_expr(
                    left,
                    op,
                    right
                );
        .)
    }
.


RelationalExpr<NodeExpr *&left>
(.
    NodeExpr *right = nullptr;
    std::string op;
.)
=
    AddExpr<left>

    {
        (
            less
          | less_equal
          | greater
          | greater_equal
        )

        (.
            op = token_string(t);
        .)

        AddExpr<right>

        (.
            left =
                make_binary_expr(
                    left,
                    op,
                    right
                );
        .)
    }
.


AddExpr<NodeExpr *&left>
(.
    NodeExpr *right = nullptr;
    std::string op;
.)
=
    MultExpr<left>

    {
        (
            plus
          | minus
        )

        (.
            op = token_string(t);
        .)

        MultExpr<right>

        (.
            left =
                make_binary_expr(
                    left,
                    op,
                    right
                );
        .)
    }
.


MultExpr<NodeExpr *&left>
(.
    NodeExpr *right = nullptr;
    std::string op;
.)
=
    UnaryExpr<left>

    {
        (
            star
          | slash
          | percent
        )

        (.
            op = token_string(t);
        .)

        UnaryExpr<right>

        (.
            left =
                make_binary_expr(
                    left,
                    op,
                    right
                );
        .)
    }
.


UnaryExpr<NodeExpr *&expr>
(.
    NodeExpr *operand = nullptr;
.)
=
      logical_not
      UnaryExpr<operand>
      (.
          expr =
              make_unary_expr(
                  "!",
                  operand
              );
      .)

    |

      minus
      UnaryExpr<operand>
      (.
          expr =
              make_unary_expr(
                  "-",
                  operand
              );
      .)

    |

      PrimaryExpr<expr>
.


PrimaryExpr<NodeExpr *&expr>
=
      identifier
      (.
          expr =
              make_identifier_expr(
                  token_string(t)
              );
      .)

    |

      int_lit
      (.
          expr =
              make_int_expr(
                  token_string(t)
              );
      .)
      |

      string_lit
      (.
          expr =
              make_string_expr(
                  token_string(t)
              );
      .)
      |
      float_lit
      (.
          expr =
             make_float_expr(
                token_string(t)
             );
      .)
      |
      double_lit
      (.
          expr =
             make_double_expr(
                token_string(t)
             );
      .)
    |

      open_paren
      Expression<expr>
      close_paren
.


END Nex.