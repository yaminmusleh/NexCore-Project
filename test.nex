set a = 10.5d;
set b = 2.5d;

set add = a + b;
set sub = a - b;
set mul = a * b;
set div = a / b;

print("DOUBLE ARITHMETIC");

iff (add > 12.9d) {
    print("ADD PASS");
}

iff (sub > 7.9d) {
    print("SUB PASS");
}

iff (mul > 26.0d) {
    print("MUL PASS");
}

iff (div > 4.1d) {
    print("DIV PASS");
}

exit(0);