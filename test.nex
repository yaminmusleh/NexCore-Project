set a = 1;
set b = 2;
set c = 3;
set d = 4;

iff(a < b & b < c & c < d) {

    set x = a + b;
    set y = x * c;
    set z = y + d;

    iff(z == 13 | z == 100) {

        iff(z >= 10 & z <= 20) {

            {
                set hidden = z * 2;

                iff(hidden == 26) {
                    exit(hidden);
                } otherwise {
                    exit(0);
                }
            }

        } otherwise {
            exit(50);
        }

    } otherwise {
        exit(60);
    }

} otherwise {
    exit(70);
}