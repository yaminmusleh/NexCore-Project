set x = 8;
set y = 3;
set result = 0;

x = x * 2 + y * 4;
y = (x - 7) % 6;

iff (x > 20 && y != 0) {
    set temp = x + y * 2;

    iff (temp >= 30 || y < 2) {
        result = temp - x / y;
    } otherwise {
        result = temp + x % y;
    }

    whilst (y > 0) {
        result = result + y;
        y = y - 1;
    }
} otherwise {
    result = x - y;
}

set a = 12;
set b = 5;
set c = 3;

a = a + b * c;
b = a % c + b;
c = (a - b) / 2;

iff (!(a < b) && (b > c || a == 0)) {
    result = result + a;
} otherwise {
    result = result - b;
}

set counter = 4;

whilst (counter > 0) {
    set step = counter * 2;

    iff (step >= 6 && !(counter == 1)) {
        result = result + step;
    } otherwise {
        result = result - step;
    }

    counter = counter - 1;
}

set p = 7;
set q = 2;

iff (p % q != 0 || !(p > 10)) {
    result = result + 25;
} otherwise {
    result = result - 25;
}

set final = result * 2 - 10;

iff (final >= 100 && final <= 200) {
    final = final + 7;
} otherwise {
    final = final - 7;
}

exit(final);