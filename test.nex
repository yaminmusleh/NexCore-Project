set x = -8;
set y = 3;
set result = 0;

whilst (x < 5) {
    iff (!(x == 0)) {
        result = result + (x * x) % 7;
    } otherwise {
        result = result + 20;
    }

    iff (x < -3) {
        result = result + 4;
    } otherwise {
        result = result - 2;
    }

    x = x + 2;
}

set quotient = result / y;
set remainder = result % y;

iff (remainder == 0) {
    result = quotient * 2;
} otherwise {
    result = quotient + remainder;
}

exit(result);