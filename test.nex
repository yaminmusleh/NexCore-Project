set name = "Yamen";
set language = "Nex";
set version = 1;
set score = 85;

print("=== Welcome to Nex ===");
print(name);
print(language);
print("Version:");
print(version);

iff (score >= 50) {
    print("You passed!");
} otherwise {
    print("You failed!");
}

set count = 1;

whilst (count <= 5) {
    print(count);
    count = count + 1;
}

print("Program finished!");
exit(0);
